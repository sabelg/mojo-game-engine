from std.testing import assert_true, assert_false, assert_equal, assert_raises
from mojo_game import Vec3, Mat4, Quaternion, Transform3D, Mesh, parse_obj, Scene3D, SceneNode, Material, TerrainConfig, Physics3D, Body3D, Bounds3D, Frustum, SceneEditor, WorldPartition, FlyCamera
from mojo_game.transform3d import gpu_matrix

def near(a: Float64,b: Float64,tolerance: Float64 = 1e-8) raises:
    assert_true(abs(a-b) < tolerance)

def main() raises:
    var rotation = Quaternion.axis_angle(Vec3(0,1,0),1.5707963267948966)
    var rotated = rotation.rotate(Vec3(0,0,1))
    near(rotated.x,1)
    near(rotated.z,0)
    var matrix = Transform3D(Vec3(1000000000.25,2,3),rotation,Vec3(2,2,2)).matrix()
    var point = matrix.point(Vec3(0,0,1))
    near(point.x,1000000002.25)
    var gpu = gpu_matrix(matrix,Vec3(1000000000,0,0))
    near(Float64(gpu[12]),0.25)
    var projection = Mat4.perspective(1.0,1.5,0.1,100)
    var frustum = Frustum(projection)
    assert_true(frustum.visible(Bounds3D(Vec3(-1,-1,-5),Vec3(1,1,-3))))
    assert_false(frustum.visible(Bounds3D(Vec3(-1,-1,3),Vec3(1,1,5))))
    assert_false(frustum.visible(Bounds3D(Vec3(100,-1,-5),Vec3(102,1,-3))))
    with assert_raises(): _ = Mat4.perspective(0,1,1,10)
    with assert_raises(): _ = Mat4.look_at(Vec3(0,0,0),Vec3(0,0,0))
    var bounds = Bounds3D(Vec3(-1,-1,-1),Vec3(1,1,1))
    near(bounds.ray(Vec3(0,0,5),Vec3(0,0,-1)),4)
    near(bounds.ray(Vec3(3,0,5),Vec3(0,0,-1)),-1)
    var mesh = parse_obj("v 0 0 0\nv 1 0 0\nv 1 1 0\nv 0 1 0\nf -4 -3 -2 -1\n")
    assert_equal(len(mesh.indices),6)
    near(Float64(mesh.vertices[5]),1)
    with assert_raises(): _ = parse_obj("v 0 0 0\nf 1 2 3\n")
    with assert_raises(): _ = parse_obj("v 0 0 0\nf 0 0 0\n")
    var cube = Mesh.cube()
    cube.validate()
    assert_equal(len(cube.indices),36)
    var sphere = Mesh.sphere(8,4)
    sphere.validate()
    var scene = Scene3D()
    var root = scene.add(SceneNode("parent",Transform3D(Vec3(1000000000,0,0))))
    var child = scene.add(SceneNode("child",Transform3D(Vec3(0.25,2,3)),0,parent=root))
    near(scene.world_matrix(child).data[12],1000000000.25)
    with assert_raises(): scene.reparent(root,child)
    var restored = Scene3D.decode(scene.encode())
    assert_equal(restored.nodes[1].name,"child")
    near(restored.world_matrix(child).data[12],1000000000.25)
    restored.reparent(child,-1)
    near(restored.world_matrix(child).data[12],0.25)
    var editor = SceneEditor()
    editor.checkpoint(scene)
    scene.nodes[child].transform.position.y = 25
    editor.undo(scene)
    near(scene.nodes[child].transform.position.y,2)
    editor.redo(scene)
    near(scene.nodes[child].transform.position.y,25)
    scene.remove(root)
    assert_false(scene.valid(child))
    with assert_raises(): _ = Scene3D.decode("not a scene")
    var terrain = TerrainConfig(seed=73,resolution=8,radius=1)
    near(terrain.height(42,19),terrain.height(42,19))
    var left = terrain.mesh(-1,0,0)
    var right = terrain.mesh(0,0,0)
    for z in range(9):
        near(Float64(left.vertices[(z*9+8)*8+1]),Float64(right.vertices[(z*9)*8+1]),1e-6)
    var low = terrain.mesh(0,0,2)
    assert_true(len(low.indices)<len(right.indices))
    var physics = Physics3D(Vec3(0,0,0))
    var a = Body3D(Vec3(0,100,0),restitution=1)
    a.velocity = Vec3(1,0,0)
    _ = physics.add(a)
    _ = physics.add(Body3D(Vec3(1,100,0),mass=0,restitution=1))
    physics.step(0.01,terrain)
    near(physics.bodies[0].velocity.x,-1)
    var hit = physics.raycast(Vec3(1,100,5),Vec3(0,0,-1))
    assert_true(Bool(hit))
    assert_equal(hit.value().body,1)
    near(hit.value().distance,4.5)
    assert_false(Bool(physics.raycast(Vec3(10,100,5),Vec3(0,0,-1))))
    var falling = Physics3D()
    _ = falling.add(Body3D(Vec3(0,100,0),restitution=0))
    for _ in range(600): falling.step(1.0/60,terrain)
    assert_true(falling.bodies[0].position.y >= terrain.height(falling.bodies[0].position.x,falling.bodies[0].position.z)+0.49)
    var camera = FlyCamera()
    var center_ray = camera.screen_ray(640,400,1280,800)
    near(center_ray.dot(camera.direction()),1)
    var partition = WorldPartition("build",radius=0,budget=1)
    partition.update(Vec3(0,0,0))
    partition.cells[0].scene = Scene3D()
    _ = partition.cells[0].scene.add(SceneNode("persisted",Transform3D(Vec3(1,2,3))))
    partition.mark_dirty(0,0)
    partition.update(Vec3(1000,0,1000))
    assert_equal(partition.find(0,0),-1)
    partition.update(Vec3(0,0,0))
    assert_equal(partition.cells[0].scene.nodes[0].name,"persisted")
    partition.save()
    print("3D core passed: transforms, precision, culling, OBJ, scenes, undo, terrain seams, physics, rays")
