from std.testing import assert_equal, assert_true, assert_raises
from std.math import sin,cos
from mojo_game import Graphics3D, Mesh, Transform3D, Mat4, Vec3, Material, TerrainConfig, WorldStreamer, Assets3D, Scene3D, SceneNode, Engine3D, Game3D, Input

struct Lifecycle(Game3D):
    var frames: Int

    def __init__(out self):
        self.frames = 0

    def update(mut self, input: Input, dt: Float64) raises:
        _ = input
        assert_true(dt > 0)

    def draw(mut self, device: Graphics3D, alpha: Float64) raises:
        assert_true(alpha >= 0 and alpha <= 1)
        device.shadow_begin(Mat4())
        device.begin(Mat4())
        self.frames += 1

def main() raises:
    var device = Graphics3D("Graphics validation",321,241,True)
    var mesh = Mesh.cube()
    var handle = device.upload(mesh)
    device.release(handle)
    var replacement = device.upload(mesh)
    assert_true(replacement != handle)
    with assert_raises(): device.release(handle)
    var light = Mat4.orthographic(20,0.1,100)*Mat4.look_at(Vec3(10,20,10),Vec3(0,0,0))
    var view = Mat4.perspective(1,321.0/241,0.1,100)
    device.shadow_begin(light)
    with assert_raises(): device.shadow(handle,Mat4())
    var model = Transform3D(Vec3(0,0,-4)).matrix()
    device.shadow(replacement,model)
    device.begin(view)
    device.draw(replacement,model,Material(Vec3(0.8,0.3,0.1)))
    assert_equal(device.draws(),1)
    assert_equal(device.triangles(),12)
    device.snapshot("build/gpu-origin.bmp")
    device.present()
    # Halfway GPU morphing must equal the corresponding static geometry,
    # including the directional shadow. Targets must share index topology.
    var next_pose=mesh.copy()
    for i in range(0,len(next_pose.vertices),8):next_pose.vertices[i]+=1
    var next_handle=device.upload(next_pose)
    assert_true(device.can_morph(replacement,next_handle))
    assert_true(not device.can_morph(handle,next_handle))
    var other_mesh=Mesh.sphere(6,4)
    var other_handle=device.upload(other_mesh)
    assert_true(not device.can_morph(replacement,other_handle))
    device.shadow_begin(light)
    with assert_raises():device.draw_morph(replacement,other_handle,0.5,model)
    with assert_raises():device.draw_morph(replacement,next_handle,1.5,model)
    device.draw_morph(replacement,next_handle,0.5,model,Material(Vec3(0.8,0.3,0.1)),shadow=True)
    device.begin(view)
    device.draw_morph(replacement,next_handle,0.5,model,Material(Vec3(0.8,0.3,0.1)))
    device.snapshot("build/gpu-morph-mid.bmp")
    device.present()
    var midpoint=Transform3D(Vec3(0.5,0,-4)).matrix()
    device.shadow_begin(light)
    device.shadow(replacement,midpoint)
    device.begin(view)
    device.draw(replacement,midpoint,Material(Vec3(0.8,0.3,0.1)))
    device.snapshot("build/gpu-morph-reference.bmp")
    device.present()
    var target_pose=mesh.copy()
    for i in range(0,len(target_pose.vertices),8):target_pose.vertices[i+1]+=1
    var target_handle=device.upload(target_pose)
    for i in range(0,len(target_pose.vertices),8):target_pose.vertices[i]+=1
    var target_next=device.upload(target_pose)
    device.shadow_begin(light)
    with assert_raises():device.draw_crossfade(replacement,next_handle,other_handle,target_next,0.25,0.75,0.5,model)
    with assert_raises():device.draw_crossfade(replacement,next_handle,target_handle,target_next,0.25,0.75,1.5,model)
    with assert_raises():device.draw_crossfade(replacement,next_handle,target_handle,target_next,0.25,-0.1,0.5,model)
    device.draw_crossfade(replacement,next_handle,target_handle,target_next,0.25,0.75,0.5,model,Material(Vec3(0.8,0.3,0.1)),shadow=True)
    device.begin(view)
    device.draw_crossfade(replacement,next_handle,target_handle,target_next,0.25,0.75,0.5,model,Material(Vec3(0.8,0.3,0.1)))
    device.snapshot("build/gpu-crossfade.bmp")
    device.present()
    var equivalent=Transform3D(Vec3(0.5,0.5,-4)).matrix()
    device.shadow_begin(light)
    device.shadow(replacement,equivalent)
    device.begin(view)
    device.draw(replacement,equivalent,Material(Vec3(0.8,0.3,0.1)))
    device.snapshot("build/gpu-crossfade-reference.bmp")
    device.present()
    device.shadow_begin(light)
    device.begin(view)
    device.draw_crossfade(replacement,next_handle,target_handle,target_next,0.25,0.75,0.5,model)
    device.release(target_next)
    with assert_raises():device.present()
    device.release(target_handle)
    device.shadow_begin(light)
    device.begin(view)
    device.draw_morph(replacement,next_handle,0.5,model)
    device.release(next_handle)
    with assert_raises():device.present()
    device.release(other_handle)
    var origin = Vec3(1000000000,1000000000,1000000000)
    var far_model = Transform3D(origin+Vec3(0,0,-4)).matrix()
    device.shadow_begin(light)
    device.shadow(replacement,far_model,origin)
    device.begin(view)
    device.draw(replacement,far_model,Material(Vec3(0.8,0.3,0.1)),origin)
    device.snapshot("build/gpu-far.bmp")
    device.present()
    var texture = device.texture("build/gpu-origin.bmp")
    with assert_raises(): _ = device.texture("assets/missing.bmp")
    device.shadow_begin(light)
    device.shadow_material(replacement,model,texture)
    device.begin(view)
    device.draw(replacement,model,Material(texture=texture))
    device.snapshot("build/gpu-textured.bmp")
    device.present()
    # Normal maps use linear sampling and add a descriptor without changing legacy materials.
    var normal = device.normal_texture("build/gpu-origin.bmp")
    with assert_raises(): device.normal_map(-1,normal)
    with assert_raises(): device.normal_map(texture,999)
    device.normal_map(texture,normal)
    device.shadow_begin(light)
    with assert_raises(): device.shadow_material(replacement,model,999)
    device.shadow_material(replacement,model,texture)
    device.begin(view)
    device.draw(replacement,model,Material(texture=texture))
    device.snapshot("build/gpu-normal-map.bmp")
    device.present()
    # Packed material maps are linear, validated, and independent of normal binding order.
    with assert_raises(): device.orm_map(-1,normal)
    with assert_raises(): device.orm_map(texture,999)
    device.orm_map(texture,normal)
    device.normal_map(texture,normal)
    device.shadow_begin(light)
    device.shadow_material(replacement,model,texture)
    device.begin(view)
    device.draw(replacement,model,Material(texture=texture))
    device.snapshot("build/gpu-orm-map.bmp")
    device.present()
    # Also isolate ORM response with no normal map: a normal-strength change
    # alone must not be enough for the image regression to pass.
    var orm_albedo = device.texture("build/gpu-origin.bmp")
    device.shadow_begin(light)
    device.shadow_material(replacement,model,orm_albedo)
    device.begin(view)
    device.draw(replacement,model,Material(texture=orm_albedo))
    device.snapshot("build/gpu-orm-base.bmp")
    device.present()
    device.orm_map(orm_albedo,normal)
    device.shadow_begin(light)
    device.shadow_material(replacement,model,orm_albedo)
    device.begin(view)
    device.draw(replacement,model,Material(texture=orm_albedo))
    device.snapshot("build/gpu-orm-only.bmp")
    device.present()
    # Triplanar mapping ignores atlas UVs and stays fixed when the world origin
    # moves. Disabling it must recover the original UV-mapped render exactly.
    var projection_texture=device.texture("build/gpu-origin.bmp")
    with assert_raises():device.triplanar(-1)
    with assert_raises():device.triplanar(999)
    with assert_raises():device.triplanar(projection_texture,-1)
    with assert_raises():device.triplanar(projection_texture,65)
    with assert_raises():device.triplanar(projection_texture,Float64("nan"))
    with assert_raises():device.triplanar(projection_texture,Float64("inf"))
    var broken_uv=mesh.copy()
    for i in range(0,len(broken_uv.vertices),8):
        broken_uv.vertices[i+6]=0
        broken_uv.vertices[i+7]=0
    var uv_handle=device.upload(broken_uv)
    for variant in range(5):
        device.triplanar(projection_texture,1.3 if variant>0 and variant<4 else 0.0)
        var test_mesh=uv_handle if variant==2 else replacement
        var test_model=far_model if variant==3 else model
        var test_origin=origin if variant==3 else Vec3(0,0,0)
        device.shadow_begin(light)
        device.shadow_material(test_mesh,test_model,projection_texture,test_origin)
        device.begin(view)
        device.draw(test_mesh,test_model,Material(texture=projection_texture),test_origin)
        device.snapshot("build/gpu-projection-"+String(variant)+".bmp")
        device.present()
    device.triplanar(projection_texture,1.3)
    device.normal_map(projection_texture,normal)
    for variant in range(2):
        if variant==1:device.orm_map(projection_texture,normal)
        device.shadow_begin(light)
        device.shadow_material(replacement,model,projection_texture)
        device.begin(view)
        device.draw(replacement,model,Material(texture=projection_texture))
        device.snapshot("build/gpu-projection-material-"+String(variant)+".bmp")
        device.present()
    device.release(uv_handle)
    # Thin-leaf transmission responds to a backlight, respects opaque blockers,
    # and restores the ordinary material exactly when disabled.
    var leaf_texture=device.texture("build/gpu-origin.bmp")
    with assert_raises():device.foliage(-1)
    with assert_raises():device.foliage(999)
    with assert_raises():device.foliage(leaf_texture,-0.1)
    with assert_raises():device.foliage(leaf_texture,1.1)
    with assert_raises():device.foliage(leaf_texture,Float64("nan"))
    with assert_raises():device.foliage(leaf_texture,Float64("inf"))
    with assert_raises():device.foliage(projection_texture)
    device.foliage(leaf_texture)
    with assert_raises():device.triplanar(leaf_texture)
    var reverse_leaf=mesh.copy()
    for i in range(0,len(reverse_leaf.vertices),8):
        for j in range(3,6):reverse_leaf.vertices[i+j]= -reverse_leaf.vertices[i+j]
    var reverse_leaf_handle=device.upload(reverse_leaf)
    var backlight=Mat4.orthographic(8,0.1,30)*Mat4.look_at(Vec3(0,0,-10),Vec3(0,0,-4))
    for variant in range(6):
        device.foliage(leaf_texture,0.7 if variant==1 or variant==3 or variant==5 else 0.0)
        device.shadow_begin(backlight)
        if variant==3 or variant==4:device.shadow(replacement,Transform3D(Vec3(0,0,-6),scale=Vec3(3,3,1)).matrix())
        device.begin(view,Vec3(0,0,-1),0)
        device.draw(reverse_leaf_handle if variant==5 else replacement,model,Material(texture=leaf_texture))
        device.snapshot("build/gpu-foliage-"+String(variant)+".bmp")
        device.present()
    device.release(reverse_leaf_handle)
    # GPU deformation must match an independently deformed CPU mesh, including
    # its shadow and analytic normal transform, at ordinary and large origins.
    device.foliage(leaf_texture,0.7)
    with assert_raises():device.wind_material(-1)
    with assert_raises():device.wind_material(999)
    with assert_raises():device.wind_material(projection_texture)
    with assert_raises():device.wind(Float64("nan"))
    with assert_raises():device.wind(Float64("inf"))
    with assert_raises():device.wind(1,-0.01)
    with assert_raises():device.wind(1,0.26)
    with assert_raises():device.wind(1,Float64("nan"))
    with assert_raises():device.wind(1,Float64("inf"))
    var wind_reference=mesh.copy()
    var direction=Vec3(0.8,0.12,0.6)
    var k1=Vec3(0.23,0.07,0.17)
    var k2=Vec3(0.71,0.19,0.53)
    for i in range(0,len(wind_reference.vertices),8):
        var p=Vec3(Float64(mesh.vertices[i]),Float64(mesh.vertices[i+1]),Float64(mesh.vertices[i+2]))
        var n=Vec3(Float64(mesh.vertices[i+3]),Float64(mesh.vertices[i+4]),Float64(mesh.vertices[i+5]))
        var a=p.dot(k1)+1.2*0.7
        var b=p.dot(k2)+3*1.2*0.7
        var gradient=(k1*(0.75*cos(a))+k2*(0.25*cos(b)))*0.25
        p=p+direction*((0.75*sin(a)+0.25*sin(b))*0.25)
        n=(n-gradient*(direction.dot(n)/(1+gradient.dot(direction)))).unit()
        wind_reference.vertices[i]=Float32(p.x)
        wind_reference.vertices[i+1]=Float32(p.y)
        wind_reference.vertices[i+2]=Float32(p.z)
        wind_reference.vertices[i+3]=Float32(n.x)
        wind_reference.vertices[i+4]=Float32(n.y)
        wind_reference.vertices[i+5]=Float32(n.z)
    var wind_handle=device.upload(wind_reference)
    for variant in range(9):
        device.wind_material(leaf_texture,variant!=0 and variant!=5 and variant!=7)
        var wind_origin=origin if variant==4 else Vec3(0,0,0)
        var wind_model=far_model if variant==4 else model
        var caster=wind_handle if variant==5 else replacement
        var floor_model=Transform3D(wind_origin+Vec3(0,-1.4,-4),scale=Vec3(4,0.1,4)).matrix()
        device.shadow_begin(light)
        if variant!=6:device.wind(2.4 if variant==2 else 1.2+8.975979010256552*1000000 if variant==8 else 1.2,0.0 if variant==3 else 0.25)
        device.shadow_material(caster,wind_model,leaf_texture,wind_origin)
        device.shadow(replacement,floor_model,wind_origin)
        device.begin(view)
        device.draw(caster,wind_model,Material(texture=leaf_texture),wind_origin)
        device.draw(replacement,floor_model,Material(Vec3(0.6,0.6,0.6)),wind_origin)
        device.snapshot("build/gpu-wind-"+String(variant)+".bmp")
        device.present()
    device.wind_material(leaf_texture,False)
    device.foliage(leaf_texture,0)
    with assert_raises():device.wind_material(leaf_texture)
    device.foliage(leaf_texture,0.7)
    device.release(wind_handle)
    var slope_texture=device.texture("build/gpu-origin.bmp")
    with assert_raises():device.slope_tint(-1)
    with assert_raises():device.slope_tint(999)
    with assert_raises():device.slope_tint(leaf_texture)
    device.slope_tint(slope_texture)
    with assert_raises():device.foliage(slope_texture)
    var slope_mesh=Mesh.sphere(16,8)
    var slope_handle=device.upload(slope_mesh)
    for variant in range(5):
        device.slope_tint(slope_texture,variant==1 or variant==2)
        device.shadow_begin(light)
        device.begin(view)
        var color=Vec3(1.6,0.6,0.85) if variant==2 or variant==3 else Vec3(1,1,1)
        device.draw(slope_handle,model,Material(color,texture=slope_texture))
        device.snapshot("build/gpu-slope-"+String(variant)+".bmp")
        device.present()
    device.release(slope_handle)
    device.shadow_begin(light)
    device.begin(view)
    with assert_raises():device.lighting(Vec3(-1,0,0),Vec3(0,0,0),Vec3(1,1,1),Vec3(0,0,0))
    device.lighting(Vec3(0.7,0.8,1),Vec3(0.2,0.3,0.1),Vec3(3.5,3.1,2.5),Vec3(0.36,0.67,0.84))
    device.draw(replacement,model,Material(Vec3(0.8,0.3,0.1)))
    device.snapshot("build/gpu-art-lighting.bmp")
    device.present()
    # Effects change only world shading, and must reset on the next begin.
    var cinema_model=Transform3D(Vec3(0,0,-8),scale=Vec3(2,2,2)).matrix()
    for variant in range(4):
        device.shadow_begin(light)
        device.shadow(replacement,cinema_model)
        device.begin(view)
        with assert_raises():device.cinematic(0,density=-1)
        with assert_raises():device.cinematic(0,falloff=0)
        with assert_raises():device.cinematic(0,strength=2)
        with assert_raises():device.cinematic(0,vignette=1)
        if variant==1:device.cinematic(0)
        if variant==3:device.cinematic(0,strength=0)
        device.draw(replacement,cinema_model,Material(Vec3(0.8,0.3,0.1)))
        device.rect(120,100,80,24,Vec3(0.2,0.8,0.4))
        device.snapshot("build/gpu-cinematic-"+String(variant)+".bmp")
        device.present()
    var font_atlas=device.texture("assets/ui/test-font.bmp")
    with assert_raises():device.triplanar(font_atlas)
    with assert_raises():device.slope_tint(font_atlas)
    with assert_raises():device.font(999)
    device.font(font_atlas)
    device.shadow_begin(light)
    device.begin(Mat4())
    device.circle(30,30,20,Vec3(1,0,0))
    device.text("Smooth HUD",65,22,Vec3(1,1,1),2)
    device.snapshot("build/gpu-font.bmp")
    device.present()
    device.resize(503,277)
    assert_equal(device.width,503)
    device.shadow_begin(light)
    device.shadow(replacement,model)
    device.begin(Mat4.perspective(1,503.0/277,0.1,100))
    device.cinematic(0)
    device.draw(replacement,model,Material(texture=texture))
    device.rect(0,0,20,20,Vec3(1,0,0))
    device.snapshot("build/gpu-resized.bmp")
    device.present()
    assert_equal(device.validation_errors(),0)
    with assert_raises(): device.resize(0,0)
    # Resource deletion after queueing is rejected before recording Vulkan commands.
    var retired = device.upload(mesh)
    device.shadow_begin(light)
    device.begin(view)
    device.draw(retired,model)
    device.release(retired)
    with assert_raises(): device.present()
    device.shadow_begin(light)
    device.begin(view)
    device.present()
    var config = TerrainConfig(resolution=8,radius=1,chunks_per_update=2)
    var world = WorldStreamer(config)
    world.update(device,Vec3(0,0,0))
    assert_equal(len(world.chunks),2)
    for _ in range(5): world.update(device,Vec3(0,0,0))
    assert_equal(len(world.chunks),9)
    for _ in range(5): world.update(device,Vec3(-1000000000,0,1000000000))
    assert_equal(len(world.chunks),9)
    assert_true(world.evictions >= 9)
    assert_equal(world.find(0,0),-1)
    world.clear(device)
    assert_equal(len(world.chunks),0)
    var assets = Assets3D()
    var asset = assets.add(device,"cube",mesh)
    assert_equal(assets.add(device,"cube",mesh),asset)
    assert_equal(len(assets.handles),1)
    var scene = Scene3D()
    _ = scene.add(SceneNode("cube",Transform3D(Vec3(0,0,-4)),asset))
    assert_equal(assets.pick(scene,Vec3(0,0,0),Vec3(0,0,-1)),0)
    assert_equal(assets.pick(scene,Vec3(0,0,0),Vec3(1,0,0)),-1)
    assets.close(device)
    device.release(replacement)
    assert_equal(device.validation_errors(),0)
    device.close()
    device.close()
    var engine = Engine3D("Lifecycle",320,240,hidden=True)
    var game = Lifecycle()
    engine.run(game,frame_limit=3)
    assert_equal(game.frames,3)
    engine.device.close()
    print("Graphics passed: generational handles, render passes, textures, floating origin, streaming budget and eviction")
