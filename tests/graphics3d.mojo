from std.testing import assert_equal, assert_true, assert_raises
from mojo_game import Graphics3D, Mesh, Transform3D, Mat4, Vec3, Material, TerrainConfig, WorldStreamer, Assets3D, Scene3D, SceneNode, Engine3D, Game3D, Input

struct Lifecycle(Game3D):
    var frames: Int

    def __init__(out self):
        self.frames = 0

    def update(mut self, input: Input, dt: Float64) raises:
        _ = input
        assert_true(dt > 0)

    def draw(mut self, device: Graphics3D, alpha: Float64) raises:
        assert_true(alpha >= 0 and alpha <= 1)
        device.shadow_begin(Mat4())
        device.begin(Mat4())
        self.frames += 1

def main() raises:
    var device = Graphics3D("Graphics validation",321,241,True)
    var mesh = Mesh.cube()
    var handle = device.upload(mesh)
    device.release(handle)
    var replacement = device.upload(mesh)
    assert_true(replacement != handle)
    with assert_raises(): device.release(handle)
    var light = Mat4.orthographic(20,0.1,100)*Mat4.look_at(Vec3(10,20,10),Vec3(0,0,0))
    var view = Mat4.perspective(1,321.0/241,0.1,100)
    device.shadow_begin(light)
    with assert_raises(): device.shadow(handle,Mat4())
    var model = Transform3D(Vec3(0,0,-4)).matrix()
    device.shadow(replacement,model)
    device.begin(view)
    device.draw(replacement,model,Material(Vec3(0.8,0.3,0.1)))
    assert_equal(device.draws(),1)
    assert_equal(device.triangles(),12)
    device.snapshot("build/gpu-origin.bmp")
    device.present()
    # Halfway GPU morphing must equal the corresponding static geometry,
    # including the directional shadow. Targets must share index topology.
    var next_pose=mesh.copy()
    for i in range(0,len(next_pose.vertices),8):next_pose.vertices[i]+=1
    var next_handle=device.upload(next_pose)
    assert_true(device.can_morph(replacement,next_handle))
    assert_true(not device.can_morph(handle,next_handle))
    var other_mesh=Mesh.sphere(6,4)
    var other_handle=device.upload(other_mesh)
    assert_true(not device.can_morph(replacement,other_handle))
    device.shadow_begin(light)
    with assert_raises():device.draw_morph(replacement,other_handle,0.5,model)
    with assert_raises():device.draw_morph(replacement,next_handle,1.5,model)
    device.draw_morph(replacement,next_handle,0.5,model,Material(Vec3(0.8,0.3,0.1)),shadow=True)
    device.begin(view)
    device.draw_morph(replacement,next_handle,0.5,model,Material(Vec3(0.8,0.3,0.1)))
    device.snapshot("build/gpu-morph-mid.bmp")
    device.present()
    var midpoint=Transform3D(Vec3(0.5,0,-4)).matrix()
    device.shadow_begin(light)
    device.shadow(replacement,midpoint)
    device.begin(view)
    device.draw(replacement,midpoint,Material(Vec3(0.8,0.3,0.1)))
    device.snapshot("build/gpu-morph-reference.bmp")
    device.present()
    device.shadow_begin(light)
    device.begin(view)
    device.draw_morph(replacement,next_handle,0.5,model)
    device.release(next_handle)
    with assert_raises():device.present()
    device.release(other_handle)
    var origin = Vec3(1000000000,1000000000,1000000000)
    var far_model = Transform3D(origin+Vec3(0,0,-4)).matrix()
    device.shadow_begin(light)
    device.shadow(replacement,far_model,origin)
    device.begin(view)
    device.draw(replacement,far_model,Material(Vec3(0.8,0.3,0.1)),origin)
    device.snapshot("build/gpu-far.bmp")
    device.present()
    var texture = device.texture("build/gpu-origin.bmp")
    with assert_raises(): _ = device.texture("assets/missing.bmp")
    device.shadow_begin(light)
    device.shadow_material(replacement,model,texture)
    device.begin(view)
    device.draw(replacement,model,Material(texture=texture))
    device.snapshot("build/gpu-textured.bmp")
    device.present()
    # Normal maps use linear sampling and add a descriptor without changing legacy materials.
    var normal = device.normal_texture("build/gpu-origin.bmp")
    with assert_raises(): device.normal_map(-1,normal)
    with assert_raises(): device.normal_map(texture,999)
    device.normal_map(texture,normal)
    device.shadow_begin(light)
    with assert_raises(): device.shadow_material(replacement,model,999)
    device.shadow_material(replacement,model,texture)
    device.begin(view)
    device.draw(replacement,model,Material(texture=texture))
    device.snapshot("build/gpu-normal-map.bmp")
    device.present()
    # Packed material maps are linear, validated, and independent of normal binding order.
    with assert_raises(): device.orm_map(-1,normal)
    with assert_raises(): device.orm_map(texture,999)
    device.orm_map(texture,normal)
    device.normal_map(texture,normal)
    device.shadow_begin(light)
    device.shadow_material(replacement,model,texture)
    device.begin(view)
    device.draw(replacement,model,Material(texture=texture))
    device.snapshot("build/gpu-orm-map.bmp")
    device.present()
    # Also isolate ORM response with no normal map: a normal-strength change
    # alone must not be enough for the image regression to pass.
    var orm_albedo = device.texture("build/gpu-origin.bmp")
    device.shadow_begin(light)
    device.shadow_material(replacement,model,orm_albedo)
    device.begin(view)
    device.draw(replacement,model,Material(texture=orm_albedo))
    device.snapshot("build/gpu-orm-base.bmp")
    device.present()
    device.orm_map(orm_albedo,normal)
    device.shadow_begin(light)
    device.shadow_material(replacement,model,orm_albedo)
    device.begin(view)
    device.draw(replacement,model,Material(texture=orm_albedo))
    device.snapshot("build/gpu-orm-only.bmp")
    device.present()
    device.shadow_begin(light)
    device.begin(view)
    with assert_raises():device.lighting(Vec3(-1,0,0),Vec3(0,0,0),Vec3(1,1,1),Vec3(0,0,0))
    device.lighting(Vec3(0.7,0.8,1),Vec3(0.2,0.3,0.1),Vec3(3.5,3.1,2.5),Vec3(0.36,0.67,0.84))
    device.draw(replacement,model,Material(Vec3(0.8,0.3,0.1)))
    device.snapshot("build/gpu-art-lighting.bmp")
    device.present()
    var font_atlas=device.texture("assets/ui/frankie-font.bmp")
    with assert_raises():device.font(999)
    device.font(font_atlas)
    device.shadow_begin(light)
    device.begin(Mat4())
    device.circle(30,30,20,Vec3(1,0,0))
    device.text("Smooth HUD",65,22,Vec3(1,1,1),2)
    device.snapshot("build/gpu-font.bmp")
    device.present()
    device.resize(503,277)
    assert_equal(device.width,503)
    device.shadow_begin(light)
    device.shadow(replacement,model)
    device.begin(Mat4.perspective(1,503.0/277,0.1,100))
    device.draw(replacement,model,Material(texture=texture))
    device.rect(0,0,20,20,Vec3(1,0,0))
    device.snapshot("build/gpu-resized.bmp")
    device.present()
    assert_equal(device.validation_errors(),0)
    with assert_raises(): device.resize(0,0)
    # Resource deletion after queueing is rejected before recording Vulkan commands.
    var retired = device.upload(mesh)
    device.shadow_begin(light)
    device.begin(view)
    device.draw(retired,model)
    device.release(retired)
    with assert_raises(): device.present()
    device.shadow_begin(light)
    device.begin(view)
    device.present()
    var config = TerrainConfig(resolution=8,radius=1,chunks_per_update=2)
    var world = WorldStreamer(config)
    world.update(device,Vec3(0,0,0))
    assert_equal(len(world.chunks),2)
    for _ in range(5): world.update(device,Vec3(0,0,0))
    assert_equal(len(world.chunks),9)
    for _ in range(5): world.update(device,Vec3(-1000000000,0,1000000000))
    assert_equal(len(world.chunks),9)
    assert_true(world.evictions >= 9)
    assert_equal(world.find(0,0),-1)
    world.clear(device)
    assert_equal(len(world.chunks),0)
    var assets = Assets3D()
    var asset = assets.add(device,"cube",mesh)
    assert_equal(assets.add(device,"cube",mesh),asset)
    assert_equal(len(assets.handles),1)
    var scene = Scene3D()
    _ = scene.add(SceneNode("cube",Transform3D(Vec3(0,0,-4)),asset))
    assert_equal(assets.pick(scene,Vec3(0,0,0),Vec3(0,0,-1)),0)
    assert_equal(assets.pick(scene,Vec3(0,0,0),Vec3(1,0,0)),-1)
    assets.close(device)
    device.release(replacement)
    assert_equal(device.validation_errors(),0)
    device.close()
    device.close()
    var engine = Engine3D("Lifecycle",320,240,hidden=True)
    var game = Lifecycle()
    engine.run(game,frame_limit=3)
    assert_equal(game.frames,3)
    engine.device.close()
    print("Graphics passed: generational handles, render passes, textures, floating origin, streaming budget and eviction")
