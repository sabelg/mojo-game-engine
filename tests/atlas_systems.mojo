"""Independent behavioral tests for Atlas streaming, authoring and simulation."""
from std.testing import assert_true,assert_false,assert_equal,assert_raises
from std.ffi import external_call
from mojo_game import Vec3,Mat4,Transform3D,Quaternion,Scene3D,SceneNode,Mesh,TerrainConfig,WorldStreamer,WorldPartition,WorldEditor,CharacterController3D,CollisionWorld3D,Bounds3D,Skeleton,Joint,AnimationClip,PoseTrack,PoseKey,SkinnedMesh,blend_pose
from mojo_game.streaming import StreamQueue,StreamJob,TERRAIN_JOB,LOAD_CELL_JOB

def near(a: Float64,b: Float64) raises:assert_true(abs(a-b)<1e-5)
def wait_job(mut queue: StreamQueue) raises -> StreamJob:
    for _ in range(5000):
        var result=queue.take()
        if result:return result.value().copy()
        external_call["SDL_Delay",NoneType](UInt32(1))
    raise Error("Worker timeout")
def main() raises:
    var queue=StreamQueue(job_limit=2)
    var terrain=TerrainConfig(resolution=8)
    for lod in range(3):
        var mesh=terrain.mesh(0,0,lod)
        assert_equal(terrain.mesh_bytes(lod),len(mesh.vertices)*4+len(mesh.indices)*4)
    var limited=WorldStreamer(TerrainConfig(radius=1,resolution=32),mesh_byte_budget=200000)
    assert_true(limited.lod_bias>0)
    assert_true(limited.resident_bytes()<=200000)
    with assert_raises():_=WorldStreamer(TerrainConfig(radius=1),mesh_byte_budget=1)
    assert_true(queue.submit(StreamJob("old",TERRAIN_JOB,terrain)))
    queue.invalidate()
    assert_true(queue.submit(StreamJob("new",TERRAIN_JOB,terrain,5,8)))
    var job=wait_job(queue)
    assert_equal(job.key,"new")
    job.mesh.validate()
    assert_true(queue.peak_bytes()<=64*1024*1024)
    with open("build/atlas-invalid.scene","w") as file:file.write("invalid")
    _=queue.submit(StreamJob("invalid",LOAD_CELL_JOB,terrain,path="build/atlas-invalid.scene"))
    job=wait_job(queue)
    assert_true(job.error.byte_length()>0)
    queue.close()
    _=queue.submit(StreamJob("restart",TERRAIN_JOB,terrain))
    job=wait_job(queue)
    assert_equal(job.key,"restart")
    queue.close()
    var directory=String("build/atlas-system-world-")+String(external_call["SDL_GetPerformanceCounter",UInt64]())
    var world=WorldPartition(directory,radius=1,asynchronous=True)
    _=external_call["mkdir",Int32](directory.as_c_string_span(),Int(493))
    var editor=WorldEditor()
    editor.place(world,SceneNode("stable",Transform3D(Vec3(255,10,1)),asset_key="test/cube"))
    var source=world.find(0,0)
    _=world.cells[source].scene.add(SceneNode("child",Transform3D(Vec3(0,1,0)),parent=editor.selected))
    editor.transform(world,Transform3D(Vec3(257,10,1)))
    var target=world.find(1,0)
    assert_equal(world.cells[target].scene.nodes[0].asset_key,"test/cube")
    assert_equal(world.cells[target].scene.nodes[1].parent,0)
    editor.undo(world)
    assert_true(world.cells[world.find(0,0)].scene.valid(0))
    assert_false(world.cells[world.find(1,0)].scene.valid(0))
    editor.redo(world)
    world.save()
    var saved=Scene3D.load(world.path(1,0))
    assert_equal(saved.nodes[0].asset_key,"test/cube")
    near(saved.world_matrix(1).data[12],257)
    var collision=CollisionWorld3D()
    _=collision.add(Bounds3D(Vec3(-100,-1,-100),Vec3(100,0,100)))
    _=collision.add(Bounds3D(Vec3(2,0,-5),Vec3(2.1,10,5)))
    var character=CharacterController3D(Vec3(0,0,0))
    character.step(collision,Vec3(0,0,0),0.01)
    assert_true(character.grounded)
    character.step(collision,Vec3(1000,0,0),0.1)
    assert_true(character.position.x<1.66)
    character.step(collision,Vec3(0,0,0),0.01,jump=True)
    assert_true(character.position.y>0)
    assert_false(character.grounded)
    var steps=CollisionWorld3D()
    _=steps.add(Bounds3D(Vec3(-5,-1,-5),Vec3(5,0,5)))
    _=steps.add(Bounds3D(Vec3(1,0,-2),Vec3(3,0.2,2)))
    var walker=CharacterController3D(Vec3(0,0,0))
    walker.step(steps,Vec3(0,0,0),0.01)
    for _ in range(40):walker.step(steps,Vec3(2,0,0),0.025)
    assert_true(walker.position.x>1.8)
    near(walker.position.y,0.2)
    var before=walker.position
    steps.move(1,Vec3(0.2,0.1,0))
    walker.step(steps,Vec3(0,0,0),0.01)
    assert_true(walker.position.x>before.x+0.19)
    near(walker.position.y,0.3)
    var skeleton=Skeleton()
    skeleton.joints.append(Joint(-1,Transform3D(),Mat4()))
    var clip=AnimationClip()
    var track=PoseTrack(0,0)
    track.keys.append(PoseKey(0,0,0,0,0))
    track.keys.append(PoseKey(1,2,0,0,0))
    clip.tracks.append(track^)
    clip.duration=1
    var pose=clip.sample(skeleton,0.5)
    near(pose[0].position.x,1)
    near(clip.sample(skeleton,1.5)[0].position.x,1)
    var bind=clip.sample(skeleton,0)
    var blended=blend_pose(bind,pose,0.5)
    near(blended[0].position.x,0.5)
    var skin=SkinnedMesh(Mesh.cube())
    for _ in range(len(skin.mesh.vertices)//8):
        for j in range(4):
            skin.joints.append(0)
            skin.weights.append(1.0 if j==0 else 0.0)
    var deformed=skin.deform(skeleton,pose)
    near(Float64(deformed.vertices[0]),Float64(skin.mesh.vertices[0])+1)
    near(deformed.minimum.x,skin.mesh.minimum.x+1)
    var identity=Transform3D(Vec3(3,4,5),Quaternion.axis_angle(Vec3(0,1,0),0.6),Vec3(2,3,4)).matrix()
    var product=identity*identity.inverse()
    for i in range(16):near(product.data[i],1.0 if i%5==0 else 0.0)
    var imported=Skeleton.load("build/atlas-cook-test/cooked/fixture-skin-0.atlasskeleton")
    var imported_clip=AnimationClip.load("build/atlas-cook-test/cooked/fixture-animation-0.atlasclip")
    var imported_skin=SkinnedMesh.load("build/atlas-cook-test/cooked/fixture-node-1-primitive-0.atlasmesh","build/atlas-cook-test/cooked/fixture-node-1-primitive-0.atlasskin")
    var imported_mesh=imported_skin.deform(imported,imported_clip.sample(imported,.5))
    near(Float64(imported_mesh.vertices[0]),1)
    var imported_scene=Scene3D.load("build/atlas-cook-test/cooked/fixture-scene.scene")
    assert_equal(imported_scene.nodes[2].asset_key,"fixture/node/mesh/primitive/0")
    print("Atlas systems passed: worker cancellation/restart/errors, cell transfers/undo/save, swept capsules/steps/platforms, skinning/blending, matrix inverse")
