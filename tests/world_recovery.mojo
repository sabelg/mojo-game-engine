"""Recover interrupted multi-cell moves at each durable transaction boundary."""
from std.ffi import external_call
from std.testing import assert_equal,assert_true,assert_false,assert_raises
from mojo_game import Scene3D,SceneNode,WorldStore,CellSnapshot,WorldPartition,WorldEditor,Vec3,Transform3D
from mojo_game.partition import WorldCell
from mojo_game.durableio import atomic_write,exists

def folder(label: String) raises -> String:
    var path=String("build/atlas-recovery-")+label+"-"+String(external_call["SDL_GetPerformanceCounter",UInt64]())
    if external_call["mkdir",Int32](path.as_c_string_span(),Int(493))!=0:raise Error("Cannot create test world")
    return path^

def main() raises:
    for fault in range(1,4):
        var directory=folder(String(fault))
        var store=WorldStore(directory.copy())
        var old=Scene3D()
        _=old.add(SceneNode("old"))
        var previous=List[CellSnapshot]()
        previous.append(CellSnapshot(0,0,0,old.copy()))
        previous.append(CellSnapshot(1,0,0,Scene3D()))
        store.commit(previous)
        var updated=List[CellSnapshot]()
        updated.append(CellSnapshot(0,0,1,Scene3D()))
        updated.append(CellSnapshot(1,0,1,old.copy()))
        with assert_raises():store.commit(updated,fault)
        store.close()
        var reopened=WorldStore(directory.copy())
        reopened.prepare()
        var source=Scene3D.load(directory+"/cell_0_0.scene")
        var destination=Scene3D.load(directory+"/cell_1_0.scene")
        assert_equal(len(source.nodes),1 if fault==1 else 0)
        assert_equal(len(destination.nodes),0 if fault==1 else 1)
        assert_equal(reopened.recoveries,0 if fault==1 else 1)
        assert_false(exists(directory+"/.atlas-transaction/commit"))
        var other=WorldStore(directory.copy())
        with assert_raises():other.prepare()
        reopened.close()
        other.prepare()
    var corrupt_directory=folder("corrupt")
    var corrupt=WorldStore(corrupt_directory.copy())
    var first=Scene3D()
    _=first.add(SceneNode("first"))
    var second=Scene3D()
    _=second.add(SceneNode("second"))
    var snapshots=List[CellSnapshot]()
    snapshots.append(CellSnapshot(0,0,0,first.copy()))
    snapshots.append(CellSnapshot(1,0,0,second.copy()))
    with assert_raises():corrupt.commit(snapshots,2)
    atomic_write(corrupt_directory+"/.atlas-transaction/cell_1_0.scene","damaged")
    corrupt.close()
    var broken=WorldStore(corrupt_directory.copy())
    with assert_raises():broken.prepare()
    assert_false(exists(corrupt_directory+"/cell_0_0.scene"))
    var world=WorldPartition(folder("identity"))
    var editor=WorldEditor()
    editor.place(world,SceneNode("persistent",Transform3D(Vec3(255,0,0))))
    var identity=world.cells[world.find(0,0)].scene.nodes[editor.selected].persistent_id.copy()
    editor.transform(world,Transform3D(Vec3(257,0,0)))
    assert_equal(world.cells[world.find(1,0)].scene.nodes[editor.selected].persistent_id,identity)
    editor.undo(world)
    editor.redo(world)
    world.save()
    var saved=Scene3D.load(world.path(1,0))
    assert_equal(saved.nodes[0].persistent_id,identity)
    var duplicate=saved.nodes[0].copy()
    with assert_raises():_=saved.add(duplicate.copy())
    editor.place(world,duplicate^)
    assert_true(world.cells[world.find(1,0)].scene.nodes[editor.selected].persistent_id!=identity)
    var legacy=Scene3D()
    _=legacy.add(SceneNode("legacy",persistent_id="legacy:payload:0"))
    var left=WorldCell(0,0,legacy.copy())
    var right=WorldCell(1,0,legacy.copy())
    assert_true(left.scene.nodes[0].persistent_id!=right.scene.nodes[0].persistent_id)
    var migrated=WorldCell(2,0,left.scene.copy())
    assert_equal(migrated.scene.nodes[0].persistent_id,left.scene.nodes[0].persistent_id)
    print("World recovery passed: precommit/committed/partial replay, checksum rejection, writer lock, stable transfer identity")
