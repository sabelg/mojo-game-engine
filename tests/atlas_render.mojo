"""Instances must match ordinary draws, including normals, shadows and origins."""
from std.testing import assert_equal,assert_true,assert_raises
from mojo_game import Graphics3D,Mesh,Mat4,Transform3D,Quaternion,Vec3,Material,WorldStreamer,TerrainConfig,Assets3D,Scene3D
from std.ffi import external_call

def main() raises:
    var device=Graphics3D("Atlas render regression",320,240,True)
    var mesh=Mesh.cube()
    var handle=device.upload(mesh)
    var matrices=List[Mat4]()
    for i in range(6):matrices.append(Transform3D(Vec3(Float64(i-3),0,-7),Quaternion.axis_angle(Vec3(0,1,0),Float64(i)*.2),Vec3(.6,1,.4)).matrix())
    var projection=Mat4.perspective(1,320.0/240,.1,100)
    var light=Mat4.orthographic(15,.1,100)*Mat4.look_at(Vec3(10,25,10),Vec3(0,0,-7))
    var material=Material(Vec3(.3,.7,.2),.4,.2)
    for mode in range(2):
        device.shadow_begin(light)
        if mode==0:
            for model in matrices:device.shadow(handle,model)
        else:device.draw_instances(handle,matrices,shadow=True)
        device.begin(projection)
        if mode==0:
            for model in matrices:device.draw(handle,model,material)
        else:device.draw_instances(handle,matrices,material)
        device.snapshot("build/atlas-instance-reference.bmp" if mode==0 else "build/atlas-instance.bmp")
        assert_equal(device.draws(),6 if mode==0 else 1)
        assert_equal(device.triangles(),72)
        device.present()
    var registry=Assets3D()
    _=registry.add(device,"unrelated-first",Mesh.cube())
    registry.load_manifest(device,"build/atlas-cook-test/cooked/fixture-assets.atlas")
    var imported=Scene3D.load("build/atlas-cook-test/cooked/fixture-scene.scene")
    imported.nodes[1].transform.position=Vec3(-.5,0,-5)
    registry.validate(imported)
    device.shadow_begin(light)
    registry.draw(device,imported,Vec3(0,0,0),light,True)
    device.begin(projection)
    registry.draw(device,imported,Vec3(0,0,0),projection)
    device.snapshot("build/atlas-manifest.bmp")
    assert_equal(device.triangles(),1)
    device.present()
    registry.close(device)
    var binary_registry=Assets3D()
    binary_registry.load_manifest(device,"build/atlas-cook-test/cooked/fixture-assets.atlasb")
    var binary_scene=Scene3D.load("build/atlas-cook-test/cooked/fixture-scene.sceneb")
    binary_registry.validate(binary_scene)
    binary_registry.close(device)
    var reload=Assets3D()
    var index=reload.add(device,"reload/cube",Mesh.cube())
    var old=reload.handles[index]
    device.shadow_begin(light)
    device.begin(projection)
    device.draw(old,matrices[0])
    reload.replace_mesh(device,"reload/cube",Mesh.cube())
    assert_equal(reload.find("reload/cube"),index)
    assert_true(reload.handles[index]!=old)
    assert_equal(len(reload.retired),1)
    device.present()
    reload.collect(device)
    assert_equal(len(reload.retired),0)
    with assert_raises():device.draw(old,matrices[0])
    var intact=reload.handles[index]
    var invalid=Mesh.cube()
    _=invalid.vertices.pop()
    with assert_raises():reload.replace_mesh(device,"reload/cube",invalid)
    assert_equal(reload.handles[index],intact)
    reload.close(device)
    var pages=device.pool_pages()
    device.release(handle)
    for _ in range(100):
        var next=device.upload(mesh)
        device.shadow_begin(light)
        device.begin(projection)
        device.draw(next,matrices[0])
        device.present()
        device.release(next)
    assert_true(device.pool_pages()<=pages+1)
    var current=device.upload(mesh)
    device.update_mesh(current,mesh)
    var bad=mesh.copy()
    _=bad.vertices.pop()
    with assert_raises():device.update_mesh(current,bad)
    device.shadow_begin(light)
    device.begin(projection)
    device.draw_instances(current,matrices)
    device.release(current)
    with assert_raises():device.present()
    var stream=WorldStreamer(TerrainConfig(radius=1,resolution=8,chunks_per_update=2),asynchronous=True)
    for _ in range(2000):
        stream.update(device,Vec3(1000000000,0,1000000000))
        if len(stream.chunks)==9:break
        external_call["SDL_Delay",NoneType](UInt32(1))
    assert_equal(len(stream.chunks),9)
    assert_true(stream.queue.peak_bytes()<=64*1024*1024)
    stream.clear(device)
    assert_equal(device.validation_errors(),0)
    print("Atlas renderer passed: instance parity inputs, reduced draws, pool reuse, dynamic meshes, stale handles, asynchronous terrain")
