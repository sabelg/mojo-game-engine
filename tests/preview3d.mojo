"""Preview/save independence, hierarchy propagation, grouped commits and raster parity."""
from std.ffi import external_call
from std.collections import Dict
from std.testing import assert_equal,assert_true,assert_raises
from mojo_game import WorldPartition,WorldEditor,SceneNode,Scene3D,Transform3D,Vec3,Quaternion,Graphics3D,Assets3D,Mesh,Mat4

def draw(device: Graphics3D,mut assets: Assets3D,scene: Scene3D,overrides: Dict[Int,Transform3D],path: String) raises:
    var origin=Vec3(64,2,12)
    var view=Mat4.perspective(1,1.5,.1,100)*Mat4.look_at(Vec3(0,0,0),Vec3(1,-1,-8))
    var light=Mat4.orthographic(24,.1,100)*Mat4.look_at(Vec3(4,8,5),Vec3(0,-1,-8))
    device.shadow_begin(light)
    assets.draw(device,scene,origin,light,True,overrides=overrides)
    device.begin(view,fog=0)
    assets.draw(device,scene,origin,view,overrides=overrides)
    device.snapshot(path)
    assert_equal(device.validation_errors(),0)

def main() raises:
    var folder="build/atlas-preview-"+String(external_call["SDL_GetPerformanceCounter",UInt64]())
    _=external_call["mkdir",Int32](folder.as_c_string_span(),Int(493))
    var world=WorldPartition(folder,cell_size=64,budget=4)
    var editor=WorldEditor()
    editor.place(world,SceneNode("first",Transform3D(Vec3(63,0,4)),asset_key="cube"))
    var first=editor.selected
    var initial_cell=world.find(0,0)
    var child=world.cells[initial_cell].scene.add(SceneNode("child",Transform3D(Vec3(.5,1,0)),parent=first,asset_key="cube"))
    world.mark_dirty(0,0)
    var child_id=world.cells[world.find(0,0)].scene.nodes[child].persistent_id.copy()
    editor.place(world,SceneNode("second",Transform3D(Vec3(62,0,4)),asset_key="cube"))
    var second=editor.selected
    editor.select(world,0,0,first)
    editor.select(world,0,0,child,True)
    editor.select(world,0,0,second,True)
    var history=len(editor.undo_stack)
    var preview=editor.preview(world)
    assert_equal(len(preview.items),2)
    preview.update(delta=Vec3(3,0,0),snap=1)
    var overrides=preview.overrides(0,0)
    assert_equal(len(overrides),2)
    var cell=world.find(0,0)
    assert_equal(world.cells[cell].scene.world_matrix(child,overrides).point(Vec3(0,0,0)).x,Float64(66.5))
    assert_equal(world.cells[cell].scene.world_matrices(overrides)[child].point(Vec3(0,0,0)).x,Float64(66.5))
    assert_equal(world.cells[cell].scene.nodes[first].transform.position.x,Float64(63))
    assert_equal(world.cells[cell].scene.nodes[second].transform.position.x,Float64(62))
    assert_equal(len(editor.undo_stack),history)
    world.save()
    var saved=Scene3D.load(world.path(0,0))
    assert_equal(saved.nodes[first].transform.position.x,Float64(63))
    assert_equal(saved.nodes[second].transform.position.x,Float64(62))
    var device=Graphics3D("Atlas grouped transform preview",240,160,True)
    device.hdr()
    var assets=Assets3D()
    _=assets.add(device,"cube",Mesh.cube())
    draw(device,assets,world.cells[cell].scene,overrides,"build/atlas-preview-overrides.bmp")
    editor.commit_preview(world,preview)
    assert_equal(len(editor.undo_stack),history+1)
    assert_equal(len(editor.selection),2)
    var target=world.find(1,0)
    var moved_child=-1
    for i in range(len(world.cells[target].scene.nodes)):
        if world.cells[target].scene.nodes[i].persistent_id==child_id and world.cells[target].scene.valid(i):moved_child=i
    assert_true(moved_child>=0)
    assert_equal(world.cells[target].scene.world_matrix(moved_child).point(Vec3(0,0,0)).x,Float64(66.5))
    draw(device,assets,world.cells[target].scene,Dict[Int,Transform3D](),"build/atlas-preview-committed.bmp")
    with assert_raises():editor.commit_preview(world,preview)
    editor.undo(world)
    cell=world.find(0,0)
    assert_true(world.cells[cell].scene.valid(first) and world.cells[cell].scene.valid(child) and world.cells[cell].scene.valid(second))
    assert_equal(world.cells[cell].scene.nodes[first].transform.position.x,Float64(63))
    editor.redo(world)
    assert_true(world.cells[world.find(1,0)].scene.valid(moved_child))
    editor.undo(world)
    editor.select(world,0,0,child)
    var stale=editor.preview(world)
    editor.select(world,0,0,first)
    var parent=world.cells[world.find(0,0)].scene.nodes[first].transform
    parent.rotation=Quaternion.axis_angle(Vec3(0,1,0),.7853981633974483)
    parent.scale=Vec3(2,1,2)
    editor.transform(world,parent)
    history=len(editor.undo_stack)
    with assert_raises():editor.commit_preview(world,stale)
    assert_equal(len(editor.undo_stack),history)
    assert_true(not editor.grouping)
    editor.select(world,0,0,child)
    var snapped=editor.preview(world)
    snapped.update(delta=Vec3(.25,0,0),snap=1)
    var position=world.cells[world.find(0,0)].scene.world_matrix(child,snapped.overrides(0,0)).point(Vec3(0,0,0))
    assert_true(abs(position.x-64)<1e-9 and abs(position.y-1)<1e-9 and abs(position.z-3)<1e-9)
    var previous=snapped.items[0].after.position
    with assert_raises():snapped.update(scale=Vec3(0,1,1))
    assert_equal(snapped.items[0].after.position.x,previous.x)
    var identity=world.cells[world.find(0,0)].scene.nodes[child].persistent_id.copy()
    world.cells[world.find(0,0)].scene.nodes[child].persistent_id="replacement"
    with assert_raises():snapped.validate(world)
    world.cells[world.find(0,0)].scene.nodes[child].persistent_id=identity^
    # Duplicating parent+child selects one root, keeps the child local, and gives
    # every clone a fresh durable identity; the second root crosses a cell edge.
    editor.select(world,0,0,first)
    editor.select(world,0,0,child,True)
    editor.select(world,0,0,second,True)
    history=len(editor.undo_stack)
    editor.duplicate_selection(world,Vec3(3,0,0))
    assert_equal(len(editor.undo_stack),history+1)
    assert_equal(len(editor.selection),2)
    var cloned=editor.selection.copy()
    for item in cloned:
        var destination=world.find(item.x,item.z)
        var subtree=world.cells[destination].scene.descendants(item.node)
        var source_node=first if len(subtree)==2 else second
        assert_equal(world.cells[destination].scene.nodes[item.node].transform.position.x,world.cells[world.find(0,0)].scene.nodes[source_node].transform.position.x+3)
        assert_true(world.cells[destination].scene.nodes[item.node].persistent_id!=world.cells[world.find(0,0)].scene.nodes[source_node].persistent_id)
        if len(subtree)==2:
            assert_equal(world.cells[destination].scene.nodes[subtree[1]].parent,item.node)
            assert_true(world.cells[destination].scene.nodes[subtree[1]].persistent_id!=child_id)
    editor.undo(world)
    for item in cloned:assert_true(not world.cells[world.find(item.x,item.z)].scene.valid(item.node))
    editor.redo(world)
    for item in cloned:assert_true(world.cells[world.find(item.x,item.z)].scene.valid(item.node))
    editor.select(world,cloned[0].x,cloned[0].z,cloned[0].node)
    editor.select(world,cloned[1].x,cloned[1].z,cloned[1].node,True)
    history=len(editor.undo_stack)
    editor.delete_selection(world)
    assert_equal(len(editor.undo_stack),history+1)
    assert_equal(len(editor.selection),0)
    for item in cloned:assert_true(not world.cells[world.find(item.x,item.z)].scene.valid(item.node))
    editor.undo(world)
    for item in cloned:assert_true(world.cells[world.find(item.x,item.z)].scene.valid(item.node))
    # A child clone stays under its original scaled/rotated parent and moves by
    # the requested WORLD offset, without losing the parent's affine transform.
    editor.select(world,0,0,child)
    var original=world.cells[world.find(0,0)].scene.world_matrix(child).point(Vec3(0,0,0))
    editor.duplicate_selection(world,Vec3(2,0,3))
    var copy_child=editor.selected
    var copied=world.cells[world.find(0,0)].scene.world_matrix(copy_child).point(Vec3(0,0,0))
    assert_equal(world.cells[world.find(0,0)].scene.nodes[copy_child].parent,first)
    assert_true(abs(copied.x-original.x-2)<1e-9 and abs(copied.z-original.z-3)<1e-9)
    history=len(editor.undo_stack)
    with assert_raises():editor.duplicate_selection(world,Vec3(Float64("inf"),0,0))
    assert_equal(len(editor.undo_stack),history)
    # Keyboard transforms share preview filtering and world-grid snapping.
    editor.select(world,0,0,child)
    editor.adjust_selection(world,Vec3(.25,0,0),snap=1)
    position=world.cells[world.find(0,0)].scene.world_matrix(child).point(Vec3(0,0,0))
    assert_true(abs(position.x-64)<1e-9 and abs(position.z-3)<1e-9)
    world.close()
    print("Transform previews passed:",device.driver(),"read-only save/render overrides, parent/child filtering, grouped cross-cell undo/redo, stale hierarchy/identity rejection and world snapping")
