from std.testing import assert_equal, assert_true, assert_false, assert_raises
from mojo_game import Vec2, Transform2D, AABB, World, Entity, ComponentStore, FixedClock, Animation, EventQueue, Body2D, Physics2D, Input, Vec3, SynthAudio
from mojo_game.math3d import clip_segment
from mojo_game.sdl import verify_layout
from mojo_game import SceneStack

def main() raises:
    verify_layout()
    var v = Vec2(3, 4)
    assert_equal(v.length(), 5.0)
    assert_equal(Vec2(0, 0).unit().x, 0.0)
    assert_true(AABB(Vec2(0, 0), Vec2(1, 1)).contains(Vec2(1, 1)))
    assert_false(AABB(Vec2(0, 0), Vec2(1, 1)).overlaps(AABB(Vec2(3, 0), Vec2(1, 1))))
    assert_equal(Transform2D(Vec2(1, 2), 0, Vec2(2, 3)).apply(Vec2(4, 5)).y, 17.0)
    var world = World()
    var store = ComponentStore[Int]()
    var a = world.create()
    store.set(world, a, 42)
    assert_equal(store.get(world, a), 42)
    assert_true(world.destroy(a))
    assert_false(world.destroy(a))
    var b = world.create()
    assert_equal(a.index, b.index)
    assert_false(store.has(world, b))
    with assert_raises():
        _ = store.get(world, a)
    with assert_raises():
        store.set(world, a, 9)
    store.set(world, b, 7)
    assert_equal(store.get(world, b), 7)
    assert_false(store.has(world, Entity(-1, 0)))
    assert_true(store.remove(world, b))
    assert_false(store.remove(world, b))
    store.collect(world)
    assert_equal(world.count, 1)
    var clock = FixedClock(100, 4)
    assert_equal(clock.advance(0.005), 0)
    assert_equal(clock.advance(0.005), 1)
    assert_equal(clock.advance(0.10), 4)
    assert_true(abs(clock.dropped-0.06) < 1e-9)
    assert_equal(clock.advance(-1), 0)
    assert_true(clock.alpha() >= 0 and clock.alpha() < 1)
    with assert_raises():
        _ = FixedClock(0)
    var animation = Animation(2, 4, 10, False)
    animation.update(0.25)
    assert_equal(animation.frame(), 4)
    animation.update(1)
    assert_equal(animation.frame(), 5)
    assert_true(animation.finished)
    animation.restart()
    assert_equal(animation.frame(), 2)
    var loop = Animation(0, 4, 10)
    loop.update(0.5)
    assert_equal(loop.frame(), 1)
    var events = EventQueue[Int]()
    events.emit(3)
    events.emit(4)
    var batch = events.drain()
    assert_equal(len(batch), 2)
    assert_equal(batch[0], 3)
    assert_equal(len(events.drain()), 0)
    var input = Input()
    input.key(4, True)
    assert_true(input.pressed(4))
    input.begin(0.01, True)
    assert_true(input.pressed(4))
    input.clear_edges()
    input.key(4, True, True)
    assert_false(input.pressed(4))
    input.lose_focus()
    assert_true(input.released(4))
    assert_false(input.down(4))
    input.begin(0.01)
    input.mouse_state(10,20,1)
    assert_true(input.mouse_pressed(1))
    input.begin(0.01)
    input.mouse_state(12,23,1)
    assert_false(input.mouse_pressed(1))
    assert_equal(input.mouse_dx,2)
    input.lose_focus()
    assert_true(input.mouse_released(1))
    assert_false(input.mouse_down(1))
    input.key(-1, True)
    assert_false(input.down(512))
    var bodies = ComponentStore[Body2D]()
    var floor = world.create()
    bodies.set(world, floor, Body2D(Vec2(0, 10), Vec2(100, 1), mass=0))
    bodies.set(world, b, Body2D(Vec2(0, 0), Vec2(1, 1)))
    var physics = Physics2D(Vec2(0, 100))
    for _ in range(120): physics.step(world, bodies, 1.0/60)
    var body = bodies.get(world, b)
    assert_true(abs(body.position.y-8) < 1e-8)
    assert_equal(body.velocity.y, 0.0)
    assert_equal(bodies.get(world, floor).position.y, 10.0)
    assert_equal(len(physics.contacts), 1)
    var sensor = world.create()
    bodies.set(world, sensor, Body2D(Vec2(0, 8), Vec2(1, 1), mass=0, sensor=True))
    physics.step(world, bodies, 0.01)
    assert_true(abs(bodies.get(world, b).position.y-8) < 1e-8)
    assert_true(len(physics.contacts) >= 2)
    var near = Vec3(0, 0, -10)
    var far = Vec3(0, 0, 20)
    assert_true(clip_segment(near, far))
    assert_true(abs(near.z-8) < 1e-8)
    var audio = SynthAudio(False)
    audio.trigger_laser()
    var samples = audio.synthesize(0, False, 512)
    assert_equal(len(samples), 512)
    audio.close()
    audio.close()
    var scenes = SceneStack(10)
    scenes.push(20)
    assert_equal(scenes.current(), 10)
    assert_true(scenes.commit())
    assert_equal(scenes.current(), 20)
    scenes.pop()
    _ = scenes.commit()
    assert_equal(scenes.current(), 10)
    scenes.pop()
    assert_false(scenes.commit())
    scenes.replace(30)
    _ = scenes.commit()
    assert_equal(scenes.current(), 30)
    var names = ComponentStore[String]()
    names.set(world, b, "player")
    assert_equal(names.get(world, b), "player")
    var bounce_world = World()
    var bounce_bodies = ComponentStore[Body2D]()
    var left = bounce_world.create()
    var right = bounce_world.create()
    var moving = Body2D(Vec2(0, 0), Vec2(1, 1), restitution=1)
    moving.velocity = Vec2(10, 0)
    bounce_bodies.set(bounce_world, left, moving)
    bounce_bodies.set(bounce_world, right, Body2D(Vec2(2, 0), Vec2(1, 1), mass=0, restitution=1))
    var bounce = Physics2D(Vec2(0, 0))
    bounce.step(bounce_world, bounce_bodies, 0.01)
    assert_equal(bounce_bodies.get(bounce_world, left).velocity.x, -10.0)
    assert_equal(bounce.contacts[0].normal.x, 1.0)
    print("Core tests passed")
